def longestSubarrayWithSumK(arr: [int], k: int) -> int:
    # Write your code here
    l,r =0,0
    n = len(arr)
    sum,maxi = 0,0
    while r<n:
        sum+=arr[r]
        while l<r and sum>k:
            sum-=arr[l]
            l+=1
        if sum==k:
            maxi = max(maxi,r-l+1)
        
        r+=1
    return maxi
            
