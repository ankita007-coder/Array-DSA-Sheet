#optimal
class Solution:
    def unionArray(self, nums1, nums2):
        if not nums2:
            return nums1
        if not nums1:
            return nums2
        i,j,n,m = 0,0,len(nums1),len(nums2)
        ans = []
        while i<n and j<m:
            if nums1[i]<=nums2[j]:
                if not ans or ans[-1]!=nums1[i]:
                    ans.append(nums1[i])
                i+=1
            else:
                if not ans or ans[-1]!=nums2[j]:
                    ans.append(nums2[j])
                j+=1
        while i<n:
            if not ans or ans[-1]!=nums1[i]:
                ans.append(nums1[i])
            i+=1
        while j<m:
            if not ans or ans[-1]!=nums2[j]:
                ans.append(nums2[j])
            j+=1
        return ans


#User function Template for python3

class Solution:
    
    #Function to return a list containing the union of the two arrays.
    def findUnion(self,a,b,n,m):
        '''
        :param a: given sorted array a
        :param n: size of sorted array a
        :param b: given sorted array b
        :param m: size of sorted array b
        :return:  The union of both arrays as a list
        '''
        # code here 
        res = []
        for i in range(n-1):
            if a[i]!=a[i+1]:
                res.append(a[i])
        if a[n-1] not in res:
            res.append(a[n-1])
        for i in range(m):
            if b[i] not in res:
                res.append(b[i])
        res = sorted(res)
        return res
